# EduCAPTCHA local configuration — copy to `.env` at the monorepo root.
# `.env` is gitignored; this file is not. Never put a real key here.
#
# Frontend only reads VITE_* into the browser bundle.
# Backend reads the rest via pydantic-settings (PROJECT_ROOT/.env).
# Agents never read .env — they receive AgentSettings from the backend.

# ── frontend (public) ───────────────────────────────────────────────────────
# Empty = fully local LearningTriggerEngine (no network).
VITE_RISK_API_URL=

# ── server ──────────────────────────────────────────────────────────────────
PORT=8080
ENV=local
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173,http://localhost:4173
RATE_LIMIT_PER_MIN=30

# ── model ───────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=minimal
GEMINI_TEMPERATURE=0
LLM_TIMEOUT_MS=1800
GRAPH_DEADLINE_MS=2200
ALLOW_NO_LLM=false

# ── policy ──────────────────────────────────────────────────────────────────
RISK_THRESHOLD=0.55
COOLDOWN_ACTIONS=3
NO_REPEAT_SKILL=true
ORCHESTRATOR_MODE=rules
SHADOW_MODE_ON_SUPPRESSED=false
FEED_ALT_TEXT_TO_VISION=false
REASON_MODE=static

# ── cache / session ─────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=1800
CACHE_MAX_ENTRIES=512
PREWARM_CACHE=true
SESSION_TTL_SECONDS=1800
SESSION_MAX_ENTRIES=2000

# ── metrics ─────────────────────────────────────────────────────────────────
METRICS_SINK=auto
GOOGLE_CLOUD_PROJECT=
METRICS_COLLECTION=educaptcha_events

# ── tracing ─────────────────────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=educaptcha-risk
