# EduCAPTCHA risk service — copy to `backend/.env` and fill in.
# `.env` is gitignored; this file is not. Never put a real key here.

# ── server ──────────────────────────────────────────────────────────────────
PORT=8080
ENV=local
LOG_LEVEL=INFO
# Origins allowed to call /risk/analyze. Vite dev is :5173, vite preview is :4173.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173,http://localhost:4173
RATE_LIMIT_PER_MIN=30

# ── model ───────────────────────────────────────────────────────────────────
# AI Studio key (https://aistudio.google.com/apikey). Works with no GCP project.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Flash defaults to "medium" thinking, which costs seconds per call. Keep minimal.
GEMINI_THINKING_LEVEL=minimal
GEMINI_TEMPERATURE=0
LLM_TIMEOUT_MS=1800
GRAPH_DEADLINE_MS=2200
# true = deterministic policy only, no model calls, no API key needed.
# Lets the frontend integrate against a real backend while prompts are still being tuned.
ALLOW_NO_LLM=false

# ── policy ──────────────────────────────────────────────────────────────────
RISK_THRESHOLD=0.55
COOLDOWN_ACTIONS=3
NO_REPEAT_SKILL=true
ORCHESTRATOR_MODE=rules
SHADOW_MODE_ON_SUPPRESSED=false
# Media alt text contains ground-truth date/location; feeding it to the vision
# agent would make the analysis a lookup. Keep false outside of debugging.
FEED_ALT_TEXT_TO_VISION=false
REASON_MODE=static

# ── cache / session ─────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=1800
CACHE_MAX_ENTRIES=512
PREWARM_CACHE=true
SESSION_TTL_SECONDS=1800
SESSION_MAX_ENTRIES=2000

# ── metrics ─────────────────────────────────────────────────────────────────
# auto = firestore when GOOGLE_CLOUD_PROJECT resolves, else jsonl
METRICS_SINK=auto
GOOGLE_CLOUD_PROJECT=
METRICS_COLLECTION=educaptcha_events

# ── tracing ─────────────────────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=educaptcha-risk
